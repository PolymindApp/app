{
  "name": "@polymind/app",
  "private": true,
  "version": "0.4.10",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:all": "concurrently -k -n WEB,API -c green,magenta \"pnpm dev\" \"pnpm api:serve\"",
    "api:serve": "bash scripts/run-php-api.sh",
    "api:migrate": "php server/migrate.php",
    "audio:normalize": "node scripts/normalize-mp3.mjs",
    "pexels:fetch": "set -a && . ./.env.prod && set +a && php scripts/fetch-pexels-images.php",
    "build": "vue-tsc --noEmit && vite build",
    "build:prod": "vue-tsc --noEmit && vite build --mode prod",
    "build:tag": "bash scripts/release-android.sh",
    "android:push": "bash scripts/build-install-android-release.sh",
    "android:sync": "pnpm build:prod && cap sync android",
    "android:assets": "capacitor-assets generate --android",
    "android:dev": "bash scripts/android-dev.sh",
    "android:open": "cap open android",
    "android:run": "pnpm android:sync && cap run android",
    "android:build": "bash scripts/build-android.sh",
    "android:build:release": "bash scripts/build-android.sh release",
    "android:bundle": "bash scripts/build-android.sh bundle",
    "android:install:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "ios:sync": "pnpm build:prod && cap sync ios",
    "ios:assets": "capacitor-assets generate --ios",
    "ios:open": "cap open ios",
    "ios:run": "pnpm ios:sync && cap run ios",
    "ios:build:release": "bash scripts/build-ios.sh",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:api": "bash server/tests/migrations.sh && bash server/tests/image-library.sh && bash server/tests/integration.sh"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/background-runner": "3.0.0",
    "@capacitor/camera": "8.2.2",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.0.2",
    "@capacitor/network": "8.0.1",
    "@mdi/font": "^7.4.47",
    "date-fns": "^4.4.0",
    "dexie": "4.4.4",
    "pinia": "^4.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.4",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^30.0.0",
    "sass": "^1.83.0",
    "typescript": "~5.6.3",
    "unplugin-fonts": "^1.3.1",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
