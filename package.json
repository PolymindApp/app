{
  "name": "mobile-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n WEB,API -c green,magenta \"pnpm dev\" \"pnpm pb:serve\"",
    "pb:download": "bash scripts/setup-pocketbase.sh",
    "pb:serve": "bash scripts/run-pocketbase.sh",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "date-fns": "^4.4.0",
    "pinia": "^4.0.2",
    "pocketbase": "^0.27.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.0",
    "sass": "^1.83.0",
    "typescript": "~5.6.3",
    "unplugin-fonts": "^1.3.1",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^6.0.5",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
