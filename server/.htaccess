Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Preserve bearer tokens when this directory is used as /server directly.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Only the front controller and authenticated migration endpoint are web-accessible.
RewriteRule ^index\.php$ - [L,NC]
RewriteRule ^migrate\.php$ - [L,NC]
RewriteRule ^ index.php [QSA,L]
