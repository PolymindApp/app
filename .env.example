# Browser build: /api is portable when the web app and PHP API share a domain.
# For a separate API host or native app build, use https://api.your-domain.example.
VITE_API_URL=/api

# PHP runtime configuration.
# Use dev only locally to include exception details in 500 responses.
DEBUG=prod

# Relative database paths are resolved from the repository root.
POLYMIND_DB_PATH=private/data.db

# Generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
POLYMIND_API_SECRET=CHANGE_ME

# Authorizes the deployment workflow to call GET /server/migrate.php.
# Generate a separate value using the same command as POLYMIND_API_SECRET.
POLYMIND_MIGRATION_KEY=

# Same-origin browser requests are always allowed. Add only exact extra origins.
# Include http://localhost for Android and capacitor://localhost for iOS builds.
POLYMIND_ALLOWED_ORIGINS=https://your-domain.example,http://localhost:5183,http://127.0.0.1:5183,http://localhost,capacitor://localhost

# Seven days. Allowed range: 300 to 2592000 seconds.
POLYMIND_TOKEN_TTL=604800

# Supports interval definitions up to 2 MB plus request overhead.
POLYMIND_MAX_BODY_BYTES=2500000

# Public browser URL used in email confirmation and password reset links.
POLYMIND_APP_URL=https://your-domain.example

# SMTP delivery used by PHPMailer. Use tls with port 587 or ssl with port 465.
# Set encryption to none only for a trusted local SMTP development server.
POLYMIND_MAIL_HOST=smtp.example.com
POLYMIND_MAIL_PORT=587
POLYMIND_MAIL_USERNAME=
POLYMIND_MAIL_PASSWORD=
POLYMIND_MAIL_ENCRYPTION=tls
POLYMIND_MAIL_FROM_ADDRESS=polymind@your-domain.example
POLYMIND_MAIL_FROM_NAME=Polymind

# Android-only passkeys. RP ID must be the host serving /.well-known/assetlinks.json.
# Key hashes are unpadded base64url SHA-256 hashes of allowed Android signing certificates.
# Leave all three values empty to disable passkeys.
POLYMIND_PASSKEY_RP_ID=
POLYMIND_PASSKEY_ANDROID_PACKAGE=
POLYMIND_PASSKEY_ANDROID_KEY_HASHES=
